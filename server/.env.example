# --- Database (Postgres) ---
# Local dev (matches the docker Postgres in the README):
DATABASE_URL=postgres://kamal:devpass@localhost:5432/kamaltrack
# Set PGSSL=true if your managed Postgres needs SSL but the URL doesn't say so.
# PGSSL=true

# --- Auth ---
# REQUIRED in production. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- AI provider ---
AI_PROVIDER=mock          # mock | gemini
GEMINI_API_KEY=           # required only when AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash

# --- Server ---
PORT=3001
# NODE_ENV=production      # in prod: hides the dev reset token from the API response
